# --- Telegram (from https://my.telegram.org and @BotFather) ---
API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:your_bot_token

# --- Arc API (this bot is just an HTTP client of your deployed Arc API) ---
API_URL=https://api.arcmusic.fun
API_KEY=your_arc_api_key

# --- Mongo (bot's own DB — user list, and every cloned bot's token) ---
MONGO_URI=mongodb://localhost:27017

# --- Log channel (REQUIRED for inline mode to deliver audio/video/photos) ---
# Telegram does not allow uploading a new file when editing an inline message —
# only a file_id or URL is accepted. So the bot first sends the downloaded file
# here (a private channel/group it's an admin of) to obtain a file_id, then uses
# that file_id to edit the inline message. Create a private channel, add this
# bot (and any clone bots) as admin with "Post Messages" permission, and put
# its numeric ID (starts with -100...) below.
LOG_CHANNEL_ID=-1000000000000

# --- Admins (comma-separated Telegram numeric user IDs) ---
OWNER_ID=123456789
SUDO_USERS=123456789,987654321

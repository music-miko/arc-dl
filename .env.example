# --- Telegram (from https://my.telegram.org and @BotFather) ---
API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:your_bot_token
# Also enable inline feedback for this bot: @BotFather -> /setinlinefeedback
# -> select this bot -> 100%. Required for on_chosen_inline_result to fire,
# which is what lets inline results turn into real media in place.

# --- YT-API (this bot is just an HTTP client of your deployed YT-API) ---
YT_API_BASE_URL=https://api.arcmusic.fun
YT_API_KEY=your_yt_api_key

# --- Mongo (bot's own DB — only stores user IDs for admin broadcasts) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ytdlbot

# --- Admins (comma-separated Telegram numeric user IDs) ---
OWNER_ID=123456789
SUDO_USERS=123456789,987654321

# --- Misc ---
DOWNLOAD_DIR=downloads
JOB_POLL_INTERVAL=2
JOB_POLL_TIMEOUT=180
MAX_LIST_BUTTONS=20
PLAYLIST_PAGE_SIZE=8
PROMO_TAG=@ArcUpdates

# --- Telegram (from https://my.telegram.org and @BotFather) ---
API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:your_bot_token

# --- Arc API (this bot is just an HTTP client of your deployed Arc API) ---
YT_API_BASE_URL=https://api.arcmusic.fun
YT_API_KEY=your_arc_api_key

# --- Mongo (bot's own DB — only stores user IDs for admin broadcasts) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=arcdl

# --- Admins (comma-separated Telegram numeric user IDs) ---
OWNER_ID=123456789
SUDO_USERS=123456789,987654321

# --- Optional overrides (each one has a sane default baked into the file
# that reads it — only set these if you actually need to change them) ---
# DOWNLOAD_DIR=downloads
# JOB_POLL_INTERVAL=2
# JOB_POLL_TIMEOUT=180
# PLAYLIST_PAGE_SIZE=8
